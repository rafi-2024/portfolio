# Database Configuration
# Development (local or Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db?schema=public"

# n8n Webhook Configuration
N8N_WEBHOOK_URL="http://localhost:5678/webhook/contact-form"

# Node Environment
NODE_ENV="development"

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Production Database Configuration (for docker-compose.prod.yml)
# Change these values in production!
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="portfolio_db"
POSTGRES_PORT=5432

# Local production-style n8n configuration
N8N_HOST="localhost"
N8N_PROTOCOL="http"
N8N_PUBLIC_WEBHOOK_URL="http://localhost:5678/"
N8N_BASIC_AUTH_ACTIVE="true"
N8N_BASIC_AUTH_USER="admin"
N8N_BASIC_AUTH_PASSWORD="changeme"
N8N_PORT=5678

# Production App Configuration
APP_PORT=3000

