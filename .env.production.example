# Production application configuration
NODE_ENV="production"
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_API_URL="https://portfolio-o0m8.onrender.com"

# Required by docker-compose.prod.yml when running the local production stack.
# Render deployments use DATABASE_URL and N8N_WEBHOOK_URL above instead.
POSTGRES_USER="portfolio_user"
POSTGRES_PASSWORD="a4b15bb5a733339c0662f0effecefefe66f7daabeee14d89ee619a8b27a2d05c"
POSTGRES_DB="portfolio_db"
N8N_BASIC_AUTH_ACTIVE="true"
N8N_BASIC_AUTH_USER="admin"
N8N_BASIC_AUTH_PASSWORD="d479b07c3d506b7b4e64fbd8ed5c96cf9b78abbdd56af14c0e0128aa9184dd41"
N8N_PUBLIC_WEBHOOK_URL="http://localhost:5678/"
APP_PORT=3000

# Database
# Render sets this from the managed Postgres service in render.yaml.
DATABASE_URL="postgresql://portfolio_user:password@host:5432/portfolio_db?schema=public"

# n8n webhook
# The app calls this URL on the separate n8n service.
# Replace <n8n-service> with that service's public Render hostname.
N8N_WEBHOOK_URL="https://portfolio-o0m8.onrender.com/webhook/contact-form"
